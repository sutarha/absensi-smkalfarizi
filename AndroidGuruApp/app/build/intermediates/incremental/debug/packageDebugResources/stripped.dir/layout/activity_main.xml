<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — Layout utama dengan WebView penuh layar + Offline page
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- WebView: tampilkan web PHP -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white" />

    <!-- Progress Bar Loading -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="#2563EB"
        android:progressTint="#2563EB"
        android:visibility="visible" />

    <!-- Offline Fallback Page (tampil jika tidak ada internet) -->
    <LinearLayout
        android:id="@+id/layoutOffline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#F8FAFC"
        android:visibility="gone">

        <!-- Ikon offline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡"
            android:textSize="72sp"
            android:layout_marginBottom="20dp" />

        <!-- Judul -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tidak Ada Koneksi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="12dp" />

        <!-- Deskripsi -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Periksa koneksi internet Anda, lalu coba lagi untuk terhubung ke Server SMK Al-Farizi."
            android:textSize="14sp"
            android:textColor="#64748B"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="32dp" />

        <!-- Tombol Retry -->
        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:paddingHorizontal="40dp"
            android:text="Coba Lagi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2563EB"
            android:textColor="@android:color/white"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Info versi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SI Presensi SMK Al-Farizi • v1.0"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</FrameLayout>
